# =====================================================================
# Salin file ini menjadi ".env" lalu isi semua nilainya sebelum
# menjalankan middleware. JANGAN commit file ".env" ke Git/Git repo
# publik karena berisi kredensial NVR & Lark.
# =====================================================================

# ---- NVR (Hikvision) ----
NVR_BASE_URL=http://192.0.2.10
NVR_USERNAME=your_nvr_username
NVR_PASSWORD=ganti_dengan_password_asli

# Daftar trackID ISAPI yang mau dipantau, dipisah koma.
# Konvensi Hikvision: trackID = (nomor channel * 100) + 3 (jalur gambar/picture)
# Contoh: D1 -> 103, D2 -> 203, D3 -> 303
NVR_TRACK_IDS=101,201,301
ATTENDANCE_ENTRY_START=06:00
ATTENDANCE_ENTRY_END=10:00
ATTENDANCE_EXIT_START=15:00
ATTENDANCE_EXIT_END=23:00
ATTENDANCE_POLL_INTERVAL_SECONDS=60

# metadataDescriptor yang dipakai saat query ContentMgmt/search.
# Nilai yang TERKONFIRMASI didukung NVR ini (dari /ISAPI/System/capabilities):
#   manualSnapShot, playSnapShot, fireDetection, thermometryAlarm,
#   accessController, videoInterCom, GJD, Luminite, OPTEX, vehicleDetection, allPic
# Default pakai 'allPic' supaya tidak ada capture otomatis yang terlewat.
# PENTING: field/skema hasil pencarian untuk kasus "ada hasil" belum
# terverifikasi 100% di percakapan pengembangan awal (kita hanya berhasil
# menguji kasus "NO MATCHES"). Jalankan tools/test_capture_search.py
# untuk memvalidasi & menyesuaikan sebelum mengandalkan ini di produksi.
NVR_PICTURE_DESCRIPTOR=//recordType.meta.std-cgi.com

# Face Library ID (FDID), didapat dari GET /ISAPI/Intelligent/FDLib
NVR_FDID=your_face_library_id

# ---- Lark ----
# Webhook URL dari Custom Bot (Settings grup Lark > Bots > Add Bot > Custom Bot)
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxxxxxxxxxx

# App ID & Secret dari Lark Developer Console (Internal App).
# Diperlukan HANYA untuk mengirim FOTO ke Lark (upload image butuh app,
# webhook custom bot saja tidak bisa upload gambar). Kalau dikosongkan,
# middleware tetap jalan tapi hanya kirim notifikasi teks tanpa foto.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Perilaku Middleware ----
# Toleransi keterlambatan scheduler setelah komputer/proses terlambat (detik).
SCHEDULE_LATE_TOLERANCE_SECONDS=120

# Jeda minimum sebelum mengirim notifikasi LAGI untuk orang yang sama
# (mencegah spam kalau satu orang berdiri lama di depan kamera)
PER_PERSON_COOLDOWN_SECONDS=60
UNKNOWN_PERSON_COOLDOWN_SECONDS=900

# Ambang batas kecocokan wajah (0.0 - 1.0). Semakin KECIL semakin KETAT.
# 0.5 adalah nilai default yang umum dipakai library face_recognition.
FACE_MATCH_TOLERANCE=0.5
FACE_MIN_CONFIDENCE=50

# Set 'false' untuk menonaktifkan face matching sepenuhnya (semua capture
# akan dikirim ke Lark dengan label "Wajah tidak dikenali").
ENABLE_FACE_MATCHING=true
ENABLE_PERSON_DETECTION=true
PERSON_DETECTOR_MODEL=yolov8n.pt
PERSON_DETECTOR_CONFIDENCE=0.35

# ---- Lokasi File ----
STATE_FILE=data/state.json
REFERENCE_DIR=data/reference_photos
LOG_DIR=logs
LOG_LEVEL=INFO
